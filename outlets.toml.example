# Copy to outlets.toml and fill in. Never commit outlets.toml: anyone in radio range
# could switch the outlets with these codes.
#
# The RF outlets, the only place their codes live. Everything else uses the id:
#   bifrost/outlet/<id>/set    ON / OFF  -> the hub sends the code to the RF bridge
#   bifrost/outlet/<id>/state  ON / OFF  <- retained, from every code heard or sent
# Homebridge gets one accessory per outlet (make deploy). Find codes with make sniff.

[[outlet]]
id = "grow-lamp"          # used in topics and by Sapling Sunrise ([light] outlet)
name = "Grow lamp"        # shown in the Home app and on the home page card
on = "1234567"            # the codes of the remote's ON and OFF buttons
off = "1234568"

# A motorised cover, the projection screen: up / stop / down buttons, no position from the motor.
# The hub times it: 0 % = rolled up at the top, 100 % = open at the projection height.
#   bifrost/cover/<id>/set   0-100 / OPEN / CLOSE / STOP
# Time it by hand: from the top, down then stop at the projection height (a Flipper "Read RAW"
# is no stopwatch: it loses the silences, the same move came out at 25.7 s and 17.3 s for 38 s).
[[cover]]
id = "screen"
name = "Projection screen"
up = "1234560"
stop = "1234561"
down = "1234562"
pulse = 188               # us, the TE of the Flipper capture (omit for 350, protocol 1)
open_time = 38            # s: down from the top to the projection height
close_time = 38           # s: up from the projection height to the top
