# Copy to .env and fill in. Never commit .env.
TZ=Europe/Paris
# MQTT login, the same as in firmware/rf-bridge/secrets.h
MQTT_USER=
MQTT_PASS=
# HomeKit bridge identity: any MAC-like id (0E:12:34:56:78:9A) and a pin like 123-45-678
HB_USERNAME=
HB_PIN=
# Optional, Alexa: an account on https://www.homebridge.ca/, then the Homebridge skill in the Alexa app.
# Empty: no Alexa. Set: make deploy adds homebridge-alexa and runs Homebridge in insecure mode (-I).
ALEXA_USER=
ALEXA_PASS=
