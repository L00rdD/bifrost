<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- make desk fills in the script, the hub and the presence, and installs it in ~/Library/LaunchAgents -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bifrost.desk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@DESK_PY@</string>
    <string>@HUB@</string>
    <string>@PRESENCE@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/bifrost-desk.log</string>
</dict>
</plist>
